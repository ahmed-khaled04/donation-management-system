    Need [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c2ac84"><TR><TD BGCOLOR="#f9ddaa" STYLE="ROUNDED" CELLPADDING="4"><B>Need</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-category: ResourceCategory<BR ALIGN="LEFT"/>-description: String<BR ALIGN="LEFT"/>-priority: int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
