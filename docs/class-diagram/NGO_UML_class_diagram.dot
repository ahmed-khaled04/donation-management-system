digraph G {
  graph [layout=dot, rankdir=LR, splines=true, overlap=false, compound=true, newrank=true,
         nodesep=0.45, ranksep=1.1, remincross=true, mclimit=4, pad=0.5, bgcolor="#fcfbf8", fontname="Helvetica,sans-Serif",
         labelloc=t, labeljust=l, style="rounded,filled", penwidth=2,
         label=<<FONT POINT-SIZE="30" COLOR="#263147"><B>UML Class Diagram</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="17" COLOR="#6a7489">NGO Management System &#160;·&#160; MVC &#160;·&#160; Strategy &#160;·&#160; Observer &#160;·&#160; Decorator &#160;·&#160; Factory &#160;·&#160; Singleton &#160;·&#160; CRUD Lookup Tables</FONT><BR ALIGN="LEFT"/> <BR ALIGN="LEFT"/>>];
  node [shape=plain, fontname="Helvetica,sans-Serif", fontsize=11];
  edge [fontname="Helvetica,sans-Serif", fontsize=10, fontcolor="#4a5468", penwidth=1.7, arrowsize=1.2];
  subgraph cluster_OBS {
    label=<<FONT POINT-SIZE="15" COLOR="#6f674a"><B>OBSERVERS | OBSERVER</B></FONT>>; fillcolor="#fff8dc"; color="#f7e7a6"; margin=14;
    Subject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><I><B>Subject</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+addObserver(o: Observer): void<BR ALIGN="LEFT"/>+removeObserver(o: Observer): void<BR ALIGN="LEFT"/>+notifyObservers(change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Observer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><I><B>Observer</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+update(source: Subject, change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    ReceiptObserver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><B>ReceiptObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+update(source: Subject, change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    ThankYouObserver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><B>ThankYouObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-notificationService: NotificationService<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+update(source: Subject, change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    StatsObserver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><B>StatsObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-totalRaised: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+update(source: Subject, change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    AttendeeNotificationObserver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><B>AttendeeNotificationObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-notificationService: NotificationService<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+update(source: Subject, change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    StockObserver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><B>StockObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+update(source: Subject, change: ChangeEvent): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    ChangeEvent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c0b481"><TR><TD BGCOLOR="#f7e7a6" STYLE="ROUNDED" CELLPADDING="4"><B>ChangeEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-payload: Object<BR ALIGN="LEFT"/>-timestamp: DateTime<BR ALIGN="LEFT"/>-type: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/>+getPayload(): Object<BR ALIGN="LEFT"/>+getTimestamp(): DateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_NOTI {
    label=<<FONT POINT-SIZE="15" COLOR="#55676c"><B>NOTIFICATIONS | STRATEGY</B></FONT>>; fillcolor="#e6f6fa"; color="#bde5f0"; margin=14;
    NotificationService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><B>NotificationService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-strategies: Map&lt;Channel, NotificationStrategy&gt;<BR ALIGN="LEFT"/>-strategy: NotificationStrategy<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registerStrategy(c: Channel, s: NotificationStrategy): void<BR ALIGN="LEFT"/>+setStrategy(s: NotificationStrategy): void<BR ALIGN="LEFT"/>+sendNotification(to: Person, msg: Message): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    NotificationStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><I><B>NotificationStrategy</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+send(to: Person, msg: Message): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    EmailStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><B>EmailStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+send(to: Person, msg: Message): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    SmsStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><B>SmsStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+send(to: Person, msg: Message): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    SocialMediaStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><B>SocialMediaStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+send(to: Person, msg: Message): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Channel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«enumeration»</FONT><BR/><B>Channel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EMAIL<BR ALIGN="LEFT"/>SMS<BR ALIGN="LEFT"/>SOCIAL<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Message [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#93b2bb"><TR><TD BGCOLOR="#bde5f0" STYLE="ROUNDED" CELLPADDING="4"><B>Message</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-subject: String<BR ALIGN="LEFT"/>-body: String<BR ALIGN="LEFT"/>-createdAt: DateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_PEOPLE {
    label=<<FONT POINT-SIZE="15" COLOR="#54675b"><B>PEOPLE</B></FONT>>; fillcolor="#e7f7ed"; color="#bce6cb"; margin=14;
    Person [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#92b39e"><TR><TD BGCOLOR="#bce6cb" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><I><B>Person</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: String<BR ALIGN="LEFT"/>-email: String<BR ALIGN="LEFT"/>-phone: String<BR ALIGN="LEFT"/>-socialHandle: String<BR ALIGN="LEFT"/>-preferredChannel: Channel<BR ALIGN="LEFT"/>-passwordHash: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Donor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#92b39e"><TR><TD BGCOLOR="#bce6cb" STYLE="ROUNDED" CELLPADDING="4"><B>Donor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-donorType: String<BR ALIGN="LEFT"/>-taxId: String<BR ALIGN="LEFT"/>-totalDonated: double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Volunteer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#92b39e"><TR><TD BGCOLOR="#bce6cb" STYLE="ROUNDED" CELLPADDING="4"><B>Volunteer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-skills: List&lt;Skill&gt;<BR ALIGN="LEFT"/>-availability: List&lt;String&gt;<BR ALIGN="LEFT"/>-totalHours: double<BR ALIGN="LEFT"/>-preferences: List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Beneficiary [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#92b39e"><TR><TD BGCOLOR="#bce6cb" STYLE="ROUNDED" CELLPADDING="4"><B>Beneficiary</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-address: String<BR ALIGN="LEFT"/>-familySize: int<BR ALIGN="LEFT"/>-needs: List&lt;Need&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    PersonService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#92b39e"><TR><TD BGCOLOR="#bce6cb" STYLE="ROUNDED" CELLPADDING="4"><B>PersonService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+register(type: String, name: String, email: String, phone: String, password: String): Person<BR ALIGN="LEFT"/>+authenticate(email: String, password: String): Person<BR ALIGN="LEFT"/>+findById(id: int): Person<BR ALIGN="LEFT"/>+searchByName(name: String): List&lt;Person&gt;<BR ALIGN="LEFT"/>+update(p: Person): void<BR ALIGN="LEFT"/>+delete(id: int): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_DON {
    label=<<FONT POINT-SIZE="15" COLOR="#635e6d"><B>DONATIONS | FACTORY + DECORATOR</B></FONT>>; fillcolor="#f1ecfb"; color="#dcd1f4"; margin=14;
    DonationService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>DonationService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-observers: List&lt;Observer&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+recordDonation(type: String, donor: Donor, amount: double): Donation<BR ALIGN="LEFT"/>+getDonationsByDonor(donor: Donor): List&lt;Donation&gt;<BR ALIGN="LEFT"/>+generateTaxStatement(donor: Donor, year: int): String<BR ALIGN="LEFT"/>+buildReceipt(donation: Donation, options: List&lt;String&gt;): Receipt<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    DonationFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>DonationFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+create(type: String, donor: Donor, amount: double): Donation</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Donation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><I><B>Donation</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-amount: double<BR ALIGN="LEFT"/>-date: DateTime<BR ALIGN="LEFT"/>-donor: Donor<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    OnlineDonation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>OnlineDonation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-transactionId: String<BR ALIGN="LEFT"/>-gateway: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    CheckDonation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>CheckDonation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-checkNumber: String<BR ALIGN="LEFT"/>-bankName: String<BR ALIGN="LEFT"/>-clearingDate: DateTime<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    InKindDonation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>InKindDonation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-itemDescription: String<BR ALIGN="LEFT"/>-quantity: int<BR ALIGN="LEFT"/>-estimatedValue: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Receipt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><I><B>Receipt</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    BasicReceipt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>BasicReceipt</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-donation: Donation<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    ReceiptDecorator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><I><B>ReceiptDecorator</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-wrapped: Receipt<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TaxInfoDecorator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>TaxInfoDecorator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    ThankYouNoteDecorator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#aba3be"><TR><TD BGCOLOR="#dcd1f4" STYLE="ROUNDED" CELLPADDING="4"><B>ThankYouNoteDecorator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_EVT {
    label=<<FONT POINT-SIZE="15" COLOR="#6f595d"><B>EVENTS | FACTORY + DECORATOR</B></FONT>>; fillcolor="#fdebef"; color="#f7c6d0"; margin=14;
    EventService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>EventService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-observers: List&lt;Observer&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+createEvent(type: String, name: String, date: DateTime, venue: String): Event<BR ALIGN="LEFT"/>+changeDate(event: Event, newDate: DateTime): void<BR ALIGN="LEFT"/>+changeVenue(event: Event, newVenue: String): void<BR ALIGN="LEFT"/>+registerAttendee(event: Event, person: Person): void<BR ALIGN="LEFT"/>+markAttendance(event: Event, person: Person): void<BR ALIGN="LEFT"/>+sellTicket(event: Event, person: Person, extras: List&lt;String&gt;): Ticket<BR ALIGN="LEFT"/>+sendReminders(event: Event): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    EventFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>EventFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+create(type: String, name: String, date: DateTime, venue: String): Event</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><I><B>Event</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: String<BR ALIGN="LEFT"/>-date: DateTime<BR ALIGN="LEFT"/>-venue: String<BR ALIGN="LEFT"/>-status: EventStatus<BR ALIGN="LEFT"/>-attendees: List&lt;Person&gt;<BR ALIGN="LEFT"/>-attended: List&lt;Person&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/>+register(p: Person): void<BR ALIGN="LEFT"/>+markAttendance(p: Person): void<BR ALIGN="LEFT"/>+updateDate(newDate: DateTime): void<BR ALIGN="LEFT"/>+updateVenue(newVenue: String): void<BR ALIGN="LEFT"/>+setStatus(s: EventStatus): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Fundraiser [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>Fundraiser</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-targetAmount: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Workshop [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>Workshop</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-capacity: int<BR ALIGN="LEFT"/>-trainer: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Outreach [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>Outreach</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-location: String<BR ALIGN="LEFT"/>-teamSize: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Ticket [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><I><B>Ticket</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrice(): double<BR ALIGN="LEFT"/>+getDescription(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    BasicTicket [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>BasicTicket</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-basePrice: double<BR ALIGN="LEFT"/>-event: Event<BR ALIGN="LEFT"/>-holder: Person<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrice(): double<BR ALIGN="LEFT"/>+getDescription(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TicketDecorator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><I><B>TicketDecorator</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-wrapped: Ticket<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrice(): double<BR ALIGN="LEFT"/>+getDescription(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    VipDecorator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#c09aa2"><TR><TD BGCOLOR="#f7c6d0" STYLE="ROUNDED" CELLPADDING="4"><B>VipDecorator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrice(): double<BR ALIGN="LEFT"/>+getDescription(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
