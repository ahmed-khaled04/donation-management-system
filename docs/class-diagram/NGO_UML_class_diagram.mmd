    %% ----- relationships: OBSERVER PATTERN -----
    Subject "1" o-- "0..*" Observer : observers
    Observer <|.. ReceiptObserver
    Observer <|.. ThankYouObserver
    Observer <|.. StatsObserver
    Observer <|.. AttendeeNotificationObserver
    Observer <|.. StockObserver
    Observer ..> ChangeEvent

    %% ----- relationships: NOTIFICATIONS (Strategy) -----
    NotificationStrategy <|.. EmailStrategy
    NotificationStrategy <|.. SmsStrategy
    NotificationStrategy <|.. SocialMediaStrategy
    NotificationService --> NotificationStrategy : strategies
    NotificationService ..> Message

    %% ----- relationships: PEOPLE -----
    Person <|-- Donor
    Person <|-- Volunteer
    Person <|-- Beneficiary
    PersonService ..> Person : manages
    PersonService ..> Donor : creates
    PersonService ..> Volunteer : creates
    PersonService ..> Beneficiary : creates

    %% ----- relationships: DONATIONS (Factory + Decorator) -----
    Donation <|-- OnlineDonation
    Donation <|-- CheckDonation
    Donation <|-- InKindDonation
    DonationFactory ..> Donation : creates
    DonationService ..> DonationFactory
    Receipt <|.. BasicReceipt
    Receipt <|.. ReceiptDecorator
    ReceiptDecorator o--> Receipt : wrapped
    ReceiptDecorator <|-- TaxInfoDecorator
    ReceiptDecorator <|-- ThankYouNoteDecorator
    BasicReceipt --> Donation : donation
    DonationService ..> Receipt : builds
    DonationService ..> Donation : records
    DonationFactory ..> OnlineDonation : creates
    DonationFactory ..> CheckDonation : creates
    DonationFactory ..> InKindDonation : creates
    DonationService ..> BasicReceipt : wraps
    DonationService ..> TaxInfoDecorator : adds
    DonationService ..> ThankYouNoteDecorator : adds

    %% ----- relationships: EVENTS (Factory + Decorator) -----
    Event <|-- Fundraiser
    Event <|-- Workshop
    Event <|-- Outreach
    EventFactory ..> Event : creates
    EventService ..> EventFactory
    Ticket <|.. BasicTicket
    Ticket <|.. TicketDecorator
    TicketDecorator o--> Ticket : wrapped
    TicketDecorator <|-- VipDecorator
    TicketDecorator <|-- MealDecorator
    BasicTicket --> Event : event
    EventService ..> Ticket : builds
    Event --> EventStatus : status
    EventFactory ..> Fundraiser : creates
    EventFactory ..> Workshop : creates
    EventFactory ..> Outreach : creates
    EventService ..> BasicTicket : wraps
    EventService ..> VipDecorator : adds
    EventService ..> MealDecorator : adds

    %% ----- relationships: BENEFICIARIES (Strategy) -----
    Distribution --> Resource : resource
    DistributionService ..> Distribution : creates
    ImpactEvaluationStrategy <|.. FoodAidImpactStrategy
    ImpactEvaluationStrategy <|.. EducationImpactStrategy
    ImpactEvaluator --> ImpactEvaluationStrategy : strategy
    DistributionService --> ImpactEvaluator : picks strategy
    ImpactEvaluator ..> Distribution : scores
    ImpactEvaluator ..> ImpactReport
    ImpactEvaluationStrategy ..> ImpactReport
