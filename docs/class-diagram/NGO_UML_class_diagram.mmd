---
config:
  class:
    hideEmptyMembersBox: false
  layout: elk
---
classDiagram
direction TB

    %% ===================== OBSERVER PATTERN =====================
    namespace Observer_Pattern {
        class Subject {
            +addObserver(o: Observer) void
            +removeObserver(o: Observer) void
            +notifyObservers(change: ChangeEvent) void
        }

        class Observer {
            +update(source: Subject, change: ChangeEvent) void
        }

        class ReceiptObserver {
            +update(source: Subject, change: ChangeEvent) void
        }

        class ThankYouObserver {
            -notificationService: NotificationService
            +update(source: Subject, change: ChangeEvent) void
        }

        class StatsObserver {
            -totalRaised: double
            +update(source: Subject, change: ChangeEvent) void
        }

        class AttendeeNotificationObserver {
            -notificationService: NotificationService
            +update(source: Subject, change: ChangeEvent) void
        }

        class StockObserver {
            +update(source: Subject, change: ChangeEvent) void
        }

        class ChangeEvent {
            -payload: Object
            -timestamp: DateTime
            -type: String
            -description: String
            +getType() String
            +getPayload() Object
            +getTimestamp() DateTime
            +getDescription() String
        }

    }

    %% ===================== NOTIFICATIONS (Strategy) =====================
    namespace Notifications_Strategy {
        class NotificationService {
            -strategies: Map~Channel, NotificationStrategy~
            -strategy: NotificationStrategy
            +registerStrategy(c: Channel, s: NotificationStrategy) void
            +setStrategy(s: NotificationStrategy) void
            +sendNotification(to: Person, msg: Message) boolean
        }

        class NotificationStrategy {
            +send(to: Person, msg: Message) boolean
        }

        class EmailStrategy {
            +send(to: Person, msg: Message) boolean
        }

        class SmsStrategy {
            +send(to: Person, msg: Message) boolean
        }

        class SocialMediaStrategy {
            +send(to: Person, msg: Message) boolean
        }

        class Channel {
            EMAIL
            SMS
            SOCIAL
        }

        class Message {
            -subject: String
            -body: String
            -createdAt: DateTime
        }

    }

    %% ===================== PEOPLE =====================
    namespace People {
        class Person {
            -id: int
            -name: String
            -email: String
            -phone: String
            -socialHandle: String
            -preferredChannel: Channel
            -passwordHash: String
        }

        class Donor {
            -donorType: String
            -taxId: String
            -totalDonated: double
        }

        class Volunteer {
            -skills: List~Skill~
            -availability: List~String~
            -totalHours: double
            -preferences: List~String~
        }

        class Beneficiary {
            -address: String
            -familySize: int
            -needs: List~Need~
        }

        class PersonService {
            -observers: List~Observer~
            +register(type: String, name: String, email: String, phone: String, password: String) Person
            +authenticate(email: String, password: String) Person
            +findById(id: int) Person
            +searchByName(name: String) List~Person~
            +update(p: Person) void
            +delete(id: int) boolean
        }

        class Session {
            -observers: List~Observer~
            -currentUser: Person
            +login(person: Person) void
            +logout() void
            +isLoggedIn() boolean
            +getCurrentUser() Person
        }

    }

    %% ===================== DONATIONS (Factory + Decorator) =====================
    namespace Donations_Factory_Decorator {
        class DonationService {
            -observers: List~Observer~
            +recordDonation(type: String, donor: Donor, amount: double) Donation
            +getDonationsByDonor(donor: Donor) List~Donation~
            +generateTaxStatement(donor: Donor, year: int) String
            +buildReceipt(donation: Donation, options: List~String~) Receipt
            +getAllDonations() List~Donation~
        }

        class DonationFactory {
            +create(type: String, donor: Donor, amount: double) Donation$
        }

        class Donation {
            -id: int
            -amount: double
            -date: DateTime
            -donor: Donor
            +getType() String
        }

        class OnlineDonation {
            -transactionId: String
            -gateway: String
            +getType() String
        }

        class CheckDonation {
            -checkNumber: String
            -bankName: String
            -clearingDate: DateTime
            +getType() String
        }

        class InKindDonation {
            -itemDescription: String
            -quantity: int
            -estimatedValue: double
            +getType() String
        }

        class Receipt {
            +render() String
        }

        class BasicReceipt {
            -donation: Donation
            +render() String
        }

        class ReceiptDecorator {
            -wrapped: Receipt
            +render() String
        }

        class TaxInfoDecorator {
            +render() String
        }

        class ThankYouNoteDecorator {
            +render() String
        }

    }

    %% ===================== EVENTS (Factory + Decorator) =====================
    namespace Events_Factory_Decorator {
        class EventService {
            -observers: List~Observer~
            +createEvent(type: String, name: String, date: DateTime, venue: String) Event
            +changeDate(event: Event, newDate: DateTime) void
            +changeVenue(event: Event, newVenue: String) void
            +registerAttendee(event: Event, person: Person) void
            +markAttendance(event: Event, person: Person) void
            +sellTicket(event: Event, person: Person, extras: List~String~) Ticket
            +sendReminders(event: Event) void
            +getTicketsByEvent(event: Event) List~Ticket~
        }

        class EventFactory {
            +create(type: String, name: String, date: DateTime, venue: String) Event$
        }

        class Event {
            -id: int
            -name: String
            -date: DateTime
            -venue: String
            -status: EventStatus
            -attendees: List~Person~
            -attended: List~Person~
            +getType() String
            +register(p: Person) void
            +markAttendance(p: Person) void
            +updateDate(newDate: DateTime) void
            +updateVenue(newVenue: String) void
            +setStatus(s: EventStatus) void
        }

        class Fundraiser {
            -targetAmount: double
            +getType() String
        }

        class Workshop {
            -capacity: int
            -trainer: String
            +getType() String
        }

        class Outreach {
            -location: String
            -teamSize: int
            +getType() String
        }

        class Ticket {
            +getPrice() double
            +getDescription() String
            +getId() int
            +getEvent() Event
        }

        class BasicTicket {
            -id: int
            -basePrice: double
            -event: Event
            -holder: Person
            +getPrice() double
            +getDescription() String
            +getId() int
            +getEvent() Event
        }

        class TicketDecorator {
            -id: int
            -wrapped: Ticket
            +getPrice() double
            +getDescription() String
            +getId() int
            +getEvent() Event
        }

        class VipDecorator {
            +getPrice() double
            +getDescription() String
        }

        class MealDecorator {
            +getPrice() double
            +getDescription() String
        }

        class EventStatus {
            PLANNED
            ONGOING
            COMPLETED
            CANCELLED
        }

    }

    %% ===================== BENEFICIARIES (Strategy) =====================
    namespace Beneficiaries_Strategy {
        class DistributionService {
            -observers: List~Observer~
            +recordDistribution(b: Beneficiary, r: Resource, quantity: int) Distribution
            +getDistributionsByBeneficiary(b: Beneficiary) List~Distribution~
            +evaluateImpact(programType: String) ImpactReport
        }

        class Distribution {
            -id: int
            -date: DateTime
            -beneficiary: Beneficiary
            -resource: Resource
            -quantity: int
        }

        class Resource {
            -id: int
            -name: String
            -unit: String
            -stockQuantity: int
            -category: ResourceCategory
        }

        class Need {
            -id: int
            -category: ResourceCategory
            -description: String
            -priority: int
        }

        class ImpactEvaluator {
            -strategy: ImpactEvaluationStrategy
            +setStrategy(s: ImpactEvaluationStrategy) void
            +evaluate(distributions: List~Distribution~) ImpactReport
        }

        class ImpactEvaluationStrategy {
            +evaluate(distributions: List~Distribution~) ImpactReport
        }

        class FoodAidImpactStrategy {
            +evaluate(distributions: List~Distribution~) ImpactReport
        }

        class EducationImpactStrategy {
            +evaluate(distributions: List~Distribution~) ImpactReport
        }

        class ImpactReport {
            -programName: String
            -score: double
            -summary: String
        }

    }

    %% ===================== VOLUNTEERS =====================
    namespace Volunteers {
        class VolunteerService {
            -observers: List~Observer~
            +assign(v: Volunteer, e: Event, role: String) Assignment
            +logHours(a: Assignment, hours: double) void
            +findBySkill(skill: Skill) List~Volunteer~
            +getAssignmentsByEvent(e: Event) List~Assignment~
            +generateCertificate(v: Volunteer) VolunteerCertificate
        }

        class Assignment {
            -id: int
            -volunteer: Volunteer
            -event: Event
            -role: String
            -hoursWorked: double
            -date: DateTime
        }

        class VolunteerCertificate {
            -volunteer: Volunteer
            -totalHours: double
            -issuedDate: DateTime
            +render() String
        }

    }

    %% ===================== LOOKUP TABLES (CRUD) =====================
    namespace Lookups_CRUD {
        class Skill {
            -id: int
            -name: String
        }

        class ResourceCategory {
            -id: int
            -name: String
            -program: String
            +getProgram() String
        }

    }

    %% ===================== VIEW (MVC) =====================
    namespace Views_MVC {
        class View {
            +show() void
            +showMessage(msg: String) void
        }

        class DonationView {
            +showDonationList(list) void
            +showReceipt(text) void
        }

        class EventView {
            +showEventList(list) void
            +showTicket(ticket) void
            +showTicketList(list) void
        }

        class BeneficiaryView {
            +showDistributions(list) void
            +showImpact(report) void
        }

        class VolunteerView {
            +showAssignments(list) void
            +showCertificate(text) void
        }

        class PersonView {
            +showLoginForm() void
            +showSignupForm() void
            +showProfile(p: Person) void
        }

        class LookupView {
            +showTable(items: List) void
            +showItemForm() void
            +addObserver(o: Observer) void
        }

        class DashboardView {
            +showAccount(user: Person) void
            +showActivity(entries: List~ActivityEntry~) void
            +closeOtherWindows() void
        }

    }

    %% ===================== CONTROLLER (MVC) =====================
    namespace Controllers_MVC {
        class DonationController {
            +loadDonations() void
            +submitDonation(type: String, donorId: int, amount: double) void
            +generateReceipt(donationId: int, options: List~String~) void
        }

        class EventController {
            +loadEvents() void
            +createEvent(type: String, name: String, date: DateTime, venue: String) void
            +changeDate(eventId: int, newDate: DateTime) void
            +registerAttendee(eventId: int, personId: int) void
            +sellTicket(eventId: int, personId: int, extras: List~String~) void
            +loadTickets(eventId: int) void
        }

        class BeneficiaryController {
            +loadBeneficiaries() void
            +recordDistribution(beneficiaryId: int, resourceId: int, quantity: int) void
            +showImpact(programType: String) void
        }

        class VolunteerController {
            +loadVolunteers() void
            +assign(volunteerId: int, eventId: int, role: String) void
            +logHours(assignmentId: int, hours: double) void
            +issueCertificate(volunteerId: int) void
        }

        class PersonController {
            +signup(type: String, name: String, email: String, phone: String, password: String) void
            +login(email: String, password: String) void
            +search(name: String) void
            +deletePerson(id: int) void
            +isLoggedIn() boolean
        }

        class LookupController {
            -observers: List~Observer~
            +loadTable(table: String) void
            +createItem(table: String, name: String) void
            +updateItem(table: String, id: int, name: String) void
            +deleteItem(table: String, id: int) void
        }

        class DashboardController {
            -wasLoggedIn: boolean
            +update(source: Subject, change: ChangeEvent) void
            +refresh() void
            +openService(service: Supplier~View~) void
            +openAuth(openWindow: Runnable) void
            +logout() void
        }

    }

    %% ===================== PERSISTENCE (Generic DAO + Singleton) =====================
    namespace Persistence_Singleton {
        class GenericDAO~T~ {
            +insert(item: T) int
            +findById(id: int) T
            +findAll() List~T~
            +update(item: T) void
            +delete(id: int) boolean
        }

        class DatabaseManager {
            -instance: DatabaseManager$
            -connection: Connection
            -DatabaseManager()
            +getInstance() DatabaseManager$
            +getConnection() Connection
        }

    }

    %% ===================== DASHBOARD (Activity log) =====================
    namespace Dashboard_ActivityLog {
        class ActivityLogService {
            -observers: List~Observer~
            -session: Session
            +update(source: Subject, change: ChangeEvent) void
            +getRecent() List~ActivityEntry~
        }

        class ActivityEntry {
            -id: int
            -time: DateTime
            -actor: String
            -description: String
        }

    }

    %% ===================== VALIDATION =====================
    namespace Validation_Rules {
        class Validation {
            +requireText(value: String, label: String) String$
            +requirePositive(value: double, max: double, label: String) void$
            +requireFutureDate(date: DateTime) void$
        }

    }

    %% ===================== STEREOTYPES =====================
    <<Interface>> Subject
    <<Interface>> Observer
    <<Interface>> NotificationStrategy
    <<enumeration>> Channel
    <<Abstract>> Person
    <<Abstract>> Donation
    <<Interface>> Receipt
    <<Abstract>> ReceiptDecorator
    <<Abstract>> Event
    <<Interface>> Ticket
    <<Abstract>> TicketDecorator
    <<enumeration>> EventStatus
    <<Interface>> ImpactEvaluationStrategy
    <<Interface>> View
    <<Singleton>> DatabaseManager

